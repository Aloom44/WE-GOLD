DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com,https://www.your-domain.com

# Use PostgreSQL in production, example:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_DB_SSL_REQUIRE=True
DJANGO_STATICFILES_STORAGE=whitenoise.storage.CompressedStaticFilesStorage

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
